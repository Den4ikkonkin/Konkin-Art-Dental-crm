# Скопируйте этот файл в .env.local и подставьте свои значения.
# Взять: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ВАШ_ANON_КЛЮЧ

# ------------------------------------------------------------
# Telegram-бот (уведомления)
# ------------------------------------------------------------
# 1. Напишите @BotFather в Telegram → /newbot → придумайте имя.
# 2. Он пришлёт токен вида 1234567890:AAH... — вставьте сюда.
# Ключ серверный: используется только маршрутом /api/telegram/test
# и локальным воркером scripts/telegram-bot.ts. В браузер он не попадает,
# потому что имя не начинается с NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Нужен ТОЛЬКО для локального воркера (npm run bot): он рассылает сводки
# без сессии браузера. Читается из .env.local на вашем компьютере.
# Взять: Supabase → Project Settings → API → service_role (secret).
# Никогда не добавляйте этот ключ в NEXT_PUBLIC_* и не коммитьте в git.
SUPABASE_SERVICE_ROLE_KEY=

# Ключ service_role сюда НЕ добавлять для фронтенда: он даёт полный доступ к базе.
# Он живёт только в этом файле на вашем компьютере и только для воркера.

# ------------------------------------------------------------
# Google Drive (файлы пациентов)
# Инструкция: GOOGLE_DRIVE_SETUP.md
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# необязательно: id своей корневой папки на Диске
GOOGLE_DRIVE_ROOT_ID=
