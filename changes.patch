+
+
+/* ============================================================
+   ОЧЕРЕДЬ: ровные карточки, 3 в ряд
+   ------------------------------------------------------------
+   ПРИЧИНА НЕРОВНОСТИ: сетка была auto-fill с минимумом 220px.
+   На широком экране влезало 5 блоков, шестой («Архив») падал
+   на второй ряд один — ряд выглядел обрезанным.
+   РЕШЕНИЕ: фиксированное число колонок. Шесть блоков ложатся
+   как 3×2 или 2×3, ряды всегда заполнены целиком.
+   ============================================================ */
+
+html body .queue-grid {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  align-items: stretch;
+}
+
+@media (max-width: 1150px) {
+  html body .queue-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 700px) {
+  html body .queue-grid { grid-template-columns: 1fr; }
+}
+
+/* Карточки в ряду одной высоты, кнопка «Открыть» прижата к низу */
+html body .queue-card {
+  height: 100%;
+  min-height: 132px;
+}
+html body .queue-card .queue-foot { margin-top: auto; }
